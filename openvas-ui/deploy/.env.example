# Copiez ce fichier en .env puis remplacez la clé :
#   openssl rand -hex 32
OPENVASD_API_KEY=a-remplacer

# Adresse:port de l'hôte où l'interface est publiée.
# Laissez 127.0.0.1 si vous passez par Nginx ou un tunnel SSH.
UI_BIND_ADDRESS=127.0.0.1:8090

# Limites de ressources, pour protéger les autres conteneurs du serveur.
# 0 = pas de limite. Exemple sur un serveur de 16 Go : 4g / 2 CPU / 1g.
OPENVASD_MEMORY_LIMIT=4g
OPENVASD_CPUS=2
REDIS_MEMORY_LIMIT=1g
