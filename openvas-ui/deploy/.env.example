# Copiez ce fichier en .env puis remplacez la clé :
#   openssl rand -hex 32
OPENVASD_API_KEY=a-remplacer

# Adresse:port de l'hôte où l'interface est publiée.
#   127.0.0.1:8090      → accessible seulement depuis le serveur (tunnel SSH / Nginx)
#   0.0.0.0:8090        → accessible depuis le réseau : définissez alors les mots de passe ci-dessous
UI_BIND_ADDRESS=127.0.0.1:8090

# Comptes de l'interface (obligatoires si l'interface est accessible sur le réseau).
# Sans UI_ADMIN_PASSWORD, l'interface n'a pas de connexion.
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=
# Compte en lecture seule (facultatif) : consulte tout, ne peut ni lancer ni supprimer de scan.
UI_VIEWER_USER=lecteur
UI_VIEWER_PASSWORD=

# Limites de ressources, pour protéger les autres conteneurs du serveur.
# 0 = pas de limite. Exemple sur un serveur de 16 Go : 4g / 2 CPU / 1g.
OPENVASD_MEMORY_LIMIT=4g
OPENVASD_CPUS=2
REDIS_MEMORY_LIMIT=1g

# Nombre de scans exécutés en même temps ; les suivants sont mis en file d'attente.
# Repère : environ 2 Go de OPENVASD_MEMORY_LIMIT par scan simultané.
OPENVASD_MAX_RUNNING_SCANS=3
