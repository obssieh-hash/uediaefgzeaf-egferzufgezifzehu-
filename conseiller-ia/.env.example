# Copiez ce fichier en ".env" et remplissez les clés.

# Claude (Anthropic) — l'IA qui lit l'actualité et donne le verdict final.
# Clé : https://console.anthropic.com  (obligatoire pour la BVMT)
ANTHROPIC_API_KEY=

# Modèle Claude (facultatif). Par défaut : claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Twelve Data — historique des actions US. Clé gratuite : https://twelvedata.com
TWELVEDATA_API_KEY=

# CoinGecko — cryptos. Fonctionne sans clé, mais une clé "Demo" gratuite donne plus de requêtes :
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Mot de passe du site (fortement conseillé si le site est en ligne, pour protéger votre facture Claude)
APP_PASSWORD=

PORT=3000
