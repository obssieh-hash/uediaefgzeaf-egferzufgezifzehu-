# =====================================================================
#  CERT-ANSIE — configuration  (/etc/vulnwatch/vulnwatch.env)
#  Après modification :  sudo systemctl restart vulnwatch
# =====================================================================

# --- Identité -----------------------------------------------------------
VW_APP_NAME=CERT-ANSIE
VW_ORG_NAME=ANSIE · Djibouti
# Marquage affiché sur l'interface et les rapports
VW_CLASSIFICATION=TLP:AMBER — Usage interne ANSIE
# URL d'accès (utilisée dans les liens des notifications)
VW_BASE_URL=https://IP_DE_LA_VM

# --- Accès à l'interface ------------------------------------------------
# Utilisés UNIQUEMENT pour créer le premier compte administrateur. Les comptes se gèrent
# ensuite dans l'interface (Administration > Utilisateurs). Mot de passe perdu :
#   sudo cert-ansie-admin reset-password admin
VW_ADMIN_USER=admin
VW_ADMIN_PASSWORD=CHANGE_MOI
VW_SECRET_KEY=GENERE_AUTOMATIQUEMENT
VW_SESSION_HOURS=12

# --- Synchronisation ----------------------------------------------------
VW_SYNC_INTERVAL_MIN=60
# Historique récupéré au premier démarrage (toutes CVE confondues)
VW_INITIAL_BACKFILL_DAYS=30
# Historique récupéré pour chaque produit ajouté au périmètre
VW_WATCH_BACKFILL_DAYS=365

# --- Clés API (optionnelles mais recommandées) --------------------------
# NVD : gratuite, demande en 1 minute -> https://nvd.nist.gov/developers/request-an-api-key
#       sans clé : synchronisation ~10x plus lente (5 requêtes / 30 s)
NVD_API_KEY=
# GitHub : token "classic" ou "fine-grained" SANS AUCUNE permission -> https://github.com/settings/tokens
#          sans token : 60 requêtes / heure (suffisant en général)
GITHUB_TOKEN=

# --- Sources (1 = activée, 0 = désactivée) -------------------------------
VW_ENABLE_NVD=1
VW_ENABLE_KEV=1
VW_ENABLE_EPSS=1
VW_ENABLE_GITHUB=1
VW_ENABLE_FEEDS=1
# CVE.org + CISA Vulnrichment : scores CVSS des CVE pas encore analysées par le NVD
VW_ENABLE_CVEORG=1
# Flux RSS supplémentaires : "Nom|url;Nom2|url2"
# ex : VW_EXTRA_FEEDS=Debian|https://www.debian.org/security/dsa;Microsoft MSRC|https://api.msrc.microsoft.com/update-guide/rss
VW_EXTRA_FEEDS=

# --- Notifications -------------------------------------------------------
# 1 = P1 uniquement, 2 = P1+P2 (recommandé), 3 = P1..P3, 4 = tout
VW_NOTIFY_MIN_PRIORITY=2

# Telegram : créer un bot avec @BotFather, puis récupérer le chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord : Paramètres du salon > Intégrations > Webhooks
DISCORD_WEBHOOK_URL=
# Slack / Mattermost / Rocket.Chat (webhook entrant)
SLACK_WEBHOOK_URL=
# Microsoft Teams (workflow "Publier dans un canal lors de la réception d'une requête webhook")
TEAMS_WEBHOOK_URL=
# E-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Proxy d'entreprise (si la VM n'a pas d'accès direct à Internet) ------
# HTTPS_PROXY=http://proxy.mondomaine.local:3128
# HTTP_PROXY=http://proxy.mondomaine.local:3128
# NO_PROXY=localhost,127.0.0.1
